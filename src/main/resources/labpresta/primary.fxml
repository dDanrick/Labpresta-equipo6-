<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="labpresta.PrimaryController">

    <!-- Barra de menú -->
    <top>
        <MenuBar>
            <Menu text="Archivo">
                <MenuItem text="Inicio" onAction="#mostrarInicio"/>
                <SeparatorMenuItem/>
                <MenuItem text="Salir" onAction="#salir"/>
            </Menu>
            <Menu text="Equipos">
                <MenuItem text="Registrar y ver equipos" onAction="#abrirEquipos"/>
            </Menu>
            <Menu text="Usuarios">
                <MenuItem text="Registrar y buscar usuarios" onAction="#abrirUsuarios"/>
            </Menu>
            <Menu text="Préstamos">
                <MenuItem text="Nuevo préstamo" onAction="#abrirNuevoPrestamo"/>
                <MenuItem text="Registrar devolución" onAction="#abrirDevolucion"/>
            </Menu>
            <Menu text="Ayuda">
                <MenuItem text="Acerca de" onAction="#acercaDe"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- Panel central: pantalla de inicio -->
    <center>
    <StackPane>
        <VBox fx:id="panelInicio" styleClass="tarjeta" alignment="CENTER" spacing="22" maxWidth="520" maxHeight="-Infinity">
            <padding>
                <Insets top="35" right="40" bottom="35" left="40"/>
            </padding>

            <Label text="LabPresta" styleClass="titulo"/>
            <Label text="Préstamo de equipos del laboratorio de computación"
                styleClass="subtitulo" wrapText="true"
                textAlignment="CENTER" alignment="CENTER"
                maxWidth="440" minHeight="-Infinity"/>

            <Button text="💻  Equipos" styleClass="boton-grande" onAction="#abrirEquipos"/>
            <Button text="👤  Usuarios" styleClass="boton-grande" onAction="#abrirUsuarios"/>
            <Button text="📋  Préstamos" styleClass="boton-grande" onAction="#abrirNuevoPrestamo"/>
        </VBox>
    </StackPane>
</center>

    <!-- Barra de estado -->
    <bottom>
           <Label fx:id="lblEstado" text="Menu" maxWidth="Infinity" styleClass="barra-estado"/>
    </bottom>
</BorderPane>

