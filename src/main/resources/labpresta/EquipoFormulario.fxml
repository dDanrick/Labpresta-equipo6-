<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="420" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="labpresta.EquipoFormularioController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20" />
   </padding>
   <Label text="Registrar equipo" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
   <Label text="Código (ejemplo: LAP-01)" />
   <TextField fx:id="txtCodigo" />
   <Label text="Tipo" />
   <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione un tipo" />
   <Label text="Descripción" />
   <TextField fx:id="txtDescripcion" />
   <Button text="Guardar" onAction="#guardar" />
   <Label fx:id="lblMensaje" wrapText="true" />
</VBox>
