<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" prefWidth="420" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="labpresta.EquipoFormularioController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20" />
   </padding>
   <Label text="Registrar equipo" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
   <Label text="Código (ejemplo: LAP-01)" />
   <TextField fx:id="txtCodigo" />
   <Label text="Tipo" />
   <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Seleccione un tipo" />
   <Label text="Descripción" />
   <TextField fx:id="txtDescripcion" />
   <Button text="Guardar" onAction="#guardar" />
   <Label fx:id="lblMensaje" wrapText="true" />

   <!-- HU-C1 · Lista de equipos con su estado -->
   <Separator />
   <Label text="Equipos registrados" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
   <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS" prefHeight="220">
      <columns>
         <TableColumn fx:id="colCodigo" text="Código" prefWidth="90" />
         <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110" />
         <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="220" />
         <TableColumn fx:id="colEstado" text="Estado" prefWidth="130" />
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>
    <HBox spacing="10" alignment="CENTER">
      <Button text="🔧 Marcar en mantenimiento" onAction="#marcarMantenimiento" />
      <Button text="✅ Devolver a disponible" onAction="#devolverDisponible" />
   </HBox>
</VBox>