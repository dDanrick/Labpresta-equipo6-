<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" prefWidth="620" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="labpresta.DevolucionController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20" />
   </padding>
   <Label text="Registrar devolución" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
   <Label text="Préstamos activos" style="-fx-font-weight: bold;" />

   <TableView fx:id="tablaPrestamos" prefHeight="260" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="90" />
         <TableColumn fx:id="colCedula" text="Cédula" prefWidth="110" />
         <TableColumn fx:id="colNombre" text="Usuario" prefWidth="180" />
         <TableColumn fx:id="colFechaPrestamo" text="Fecha préstamo" prefWidth="110" />
         <TableColumn fx:id="colFechaLimite" text="Fecha límite" prefWidth="110" />
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>

   <Label text="Fecha de devolución" />
   <DatePicker fx:id="dpFecha" maxWidth="Infinity" />
   
   <Button text="✅ Registrar devolución" onAction="#registrarDevolucion" />
   <Label fx:id="lblMensaje" wrapText="true" />
</VBox>
